# Web-UI: Entra ID app registration (SPA). See ENTRA-ID-SETUP.md. Not a secret.
VITE_ENTRA_CLIENT_ID=
# Multi-tenant: https://login.microsoftonline.com/organizations (default)
# Single-tenant: https://login.microsoftonline.com/<tenantId>
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Optional: Azure OpenAI (Azure AI Foundry) for the "KI-Analyse" button (IPv6-leak / architecture-gap
# analysis of the ANONYMIZED export — see src/export/sanitize.ts and SECURITY.md). Leave empty to
# hide the feature. The API key ends up in the built client bundle (this is a browser-only SPA with
# no backend) — use a low-privilege, cost-capped Azure OpenAI deployment, never a tenant-wide key.
VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_API_KEY=
VITE_AZURE_OPENAI_MODEL=
