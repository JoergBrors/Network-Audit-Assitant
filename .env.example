# Web-UI: Entra ID app registration (SPA). See ENTRA-ID-SETUP.md. Not a secret.
VITE_ENTRA_CLIENT_ID=
# Multi-tenant: https://login.microsoftonline.com/organizations (default)
# Single-tenant: https://login.microsoftonline.com/<tenantId>
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Optional: Azure OpenAI (Microsoft Foundry) for "KI-Analyse". The export is sent UNCHANGED (not
# anonymized) – use only an internal deployment approved for this data. Leave empty to hide the feature.
# Endpoint of the resource, e.g. https://my-resource.openai.azure.com (the /openai/v1 path is added).
VITE_AZURE_OPENAI_ENDPOINT=
# Deployment name, e.g. gpt-5-mini
VITE_AZURE_OPENAI_MODEL=
# Optional: minimal | low | medium | high. Default for reasoning models (gpt-5*, o*): low (fast chat);
# the final report uses one level more.
VITE_AZURE_OPENAI_REASONING_EFFORT=
# Optional Entra ID token scope (default https://cognitiveservices.azure.com/.default).
VITE_AZURE_OPENAI_SCOPE=
# Recommended: leave empty – the signed-in user's Entra ID token is used (ENTRA-ID-SETUP.md § 8.1).
# Only as a fallback without sign-in (e.g. offline JSON import): an API key ends up in the client bundle.
VITE_AZURE_OPENAI_API_KEY=
